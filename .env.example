# ---- Summarization LLM (OpenAI-compatible endpoint) ----
LLM_BASE_URL=https://consoletoken.aunjai.org/api/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gemma-4-12b

# ---- เลือกตัวถอดเสียง ----
# local = whisper.cpp ในเครื่อง (ฟรี เสียงไม่ออกจากเครื่อง ต้องมี GPU ถึงจะเร็ว)
# api   = ส่งไป /audio/transcriptions แบบ OpenAI (ไม่ต้องมี GPU เสียเงิน เสียงออกจากเครื่อง)
# เลือกต่อการประชุมได้ในหน้าเว็บ ค่านี้เป็นแค่ค่าเริ่มต้น
STT_PROVIDER=local
STT_MODEL=whisper-1
# ว่างไว้ = ใช้ค่าเดียวกับ LLM_BASE_URL / LLM_API_KEY
# (endpoint แบบ LiteLLM มักให้ทั้งสรุปและถอดเสียงด้วยคีย์เดียว ถ้าคีย์มีสิทธิ์เข้าโมเดลนั้น)
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=

# ---- Transcription (whisper.cpp) ----
# path to the whisper-cli binary (leave 'whisper-cli' if on PATH from brew)
# Windows: point at the extracted build, e.g. bin/whisper/Release/whisper-cli.exe
WHISPER_BIN=whisper-cli
# path to the ggml model file (downloaded by setup.sh)
# turbo-q5 = เร็ว+เบา (แนะนำ) · large-v3 = แม่นสุดแต่ช้า
WHISPER_MODEL=models/ggml-large-v3-turbo-q5_0.bin
# default spoken language of meetings (th, en, ja, auto, ...)
WHISPER_LANG=th
# number of CPU threads
WHISPER_THREADS=8

# ---- Remote worker (ใช้ตอน deploy เว็บขึ้น cloud ที่ไม่มี GPU) ----
# ฝั่งเซิร์ฟเวอร์: REMOTE_WORKER=1 = ไม่ประมวลผลเอง รอ `mai worker` มารับงาน
# ปล่อยเป็น 0 = เว็บทำงานเองในเครื่องเหมือนเดิม
REMOTE_WORKER=0
# ต้องตั้งค่านี้ทั้งสองฝั่งให้ตรงกัน — ว่างไว้ = ปิด worker API ทั้งชุด
# สร้างด้วย: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_TOKEN=

# ---- โหมด cloud (ไม่ตั้ง = ทำงานในเครื่อง เก็บเป็นไฟล์ ไม่มีล็อกอิน) ----
# ต้องเปิดอย่างชัดเจน: `mai web --cloud` หรือ MEETING_AI_CLOUD=1
# แค่มี DATABASE_URL เฉยๆ จะไม่สลับโหมดให้ (กันเผลอทำเครื่องมือในเครื่องเปลี่ยนพฤติกรรม)
# MEETING_AI_CLOUD=1

# Postgres — Neon แนะนำให้ใช้ host ที่มี -pooler
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ที่เก็บไฟล์เสียง — Cloudflare R2 (หรืออะไรก็ได้ที่พูด S3)
# ไม่ตั้ง = เก็บลงดิสก์ (ใช้ได้เฉพาะตอนรันในเครื่อง — Vercel เขียนดิสก์ไม่ได้)
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=meeting-ai
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# ---- Recording (ffmpeg: avfoundation on macOS, dshow on Windows) ----
FFMPEG_BIN=ffmpeg
# audio device index as printed by `mai devices` — a device name also works
# MIC_DEVICE    = your microphone
# SYSTEM_DEVICE = the loopback that captures meeting audio
#                 macOS: BlackHole · Windows: VB-CABLE / Stereo Mix
# leave SYSTEM_DEVICE empty if you have no loopback yet (then use: mai record ... --no-system)
MIC_DEVICE=0
SYSTEM_DEVICE=1
