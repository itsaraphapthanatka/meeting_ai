# ---- Summarization LLM (OpenAI-compatible endpoint) ----
LLM_BASE_URL=https://consoletoken.aunjai.org/api/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gemma-4-12b

# ---- Transcription (whisper.cpp) ----
# path to the whisper-cli binary (leave 'whisper-cli' if on PATH from brew)
# Windows: point at the extracted build, e.g. bin/whisper/Release/whisper-cli.exe
WHISPER_BIN=whisper-cli
# path to the ggml model file (downloaded by setup.sh)
# turbo-q5 = เร็ว+เบา (แนะนำ) · large-v3 = แม่นสุดแต่ช้า
WHISPER_MODEL=models/ggml-large-v3-turbo-q5_0.bin
# default spoken language of meetings (th, en, ja, auto, ...)
WHISPER_LANG=th
# number of CPU threads
WHISPER_THREADS=8

# ---- Remote worker (ใช้ตอน deploy เว็บขึ้น cloud ที่ไม่มี GPU) ----
# ฝั่งเซิร์ฟเวอร์: REMOTE_WORKER=1 = ไม่ประมวลผลเอง รอ `mai worker` มารับงาน
# ปล่อยเป็น 0 = เว็บทำงานเองในเครื่องเหมือนเดิม
REMOTE_WORKER=0
# ต้องตั้งค่านี้ทั้งสองฝั่งให้ตรงกัน — ว่างไว้ = ปิด worker API ทั้งชุด
# สร้างด้วย: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_TOKEN=

# ---- Cloud storage (ยังไม่ใช้ในโหมดในเครื่อง) ----
# Postgres สำหรับเก็บข้อมูลตอน deploy ขึ้น Vercel เช่น Neon
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ---- Recording (ffmpeg: avfoundation on macOS, dshow on Windows) ----
FFMPEG_BIN=ffmpeg
# audio device index as printed by `mai devices` — a device name also works
# MIC_DEVICE    = your microphone
# SYSTEM_DEVICE = the loopback that captures meeting audio
#                 macOS: BlackHole · Windows: VB-CABLE / Stereo Mix
# leave SYSTEM_DEVICE empty if you have no loopback yet (then use: mai record ... --no-system)
MIC_DEVICE=0
SYSTEM_DEVICE=1
