# ---- Summarization LLM (OpenAI-compatible endpoint) ----
LLM_BASE_URL=https://consoletoken.aunjai.org/api/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gemma-4-12b
# เพดาน token ของคำตอบ ถ้าสรุปถูกตัดกลางคัน ระบบจะขยายเป็นเท่าตัวจนถึง CEILING แล้วจึง error
LLM_MAX_TOKENS=4000
LLM_MAX_TOKENS_CEILING=16000
# บทถอดเสียงยาวเกินนี้ (ตัวอักษร) จะถูกแบ่งเป็นก้อนแล้วสรุปแบบ map-reduce
# ประชุมไทยราว 900 ตัวอักษร/นาที -> 24,000 = ราว 27 นาทีต่อก้อน
# โมเดลที่มี context ใหญ่ตั้งให้สูงขึ้นได้ = เรียก LLM น้อยลงและสรุปดีขึ้น
# เหตุผลทั้งหมด: docs/adr/ADR-001-transcript-chunking.md
LLM_CHUNK_CHARS=24000

# ---- เลือกตัวถอดเสียง ----
# local = whisper.cpp ในเครื่อง (ฟรี เสียงไม่ออกจากเครื่อง ต้องมี GPU ถึงจะเร็ว)
# api   = ส่งไป /audio/transcriptions แบบ OpenAI (ไม่ต้องมี GPU เสียเงิน เสียงออกจากเครื่อง)
# เลือกต่อการประชุมได้ในหน้าเว็บ ค่านี้เป็นแค่ค่าเริ่มต้น
# ตั้ง local ไว้ = สั่งว่าห้ามส่งเสียงออกนอกเครื่อง ถ้าไม่มี whisper/โมเดล งานจะ error ให้เห็น
# ไม่ใช่เงียบ ๆ อัปโหลดไป API (BUG-019) · ไม่ตั้งบรรทัดนี้เลย = ยอมให้ตกไป API ได้ถ้าไม่มี whisper
STT_PROVIDER=local
STT_MODEL=whisper-1
# ว่างไว้ = ใช้ค่าเดียวกับ LLM_BASE_URL / LLM_API_KEY
# (endpoint แบบ LiteLLM มักให้ทั้งสรุปและถอดเสียงด้วยคีย์เดียว ถ้าคีย์มีสิทธิ์เข้าโมเดลนั้น)
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=

# ---- Transcription (whisper.cpp) ----
# path to the whisper-cli binary (leave 'whisper-cli' if on PATH from brew)
# Windows: point at the extracted build, e.g. bin/whisper/Release/whisper-cli.exe
WHISPER_BIN=whisper-cli
# path to the ggml model file (downloaded by setup.sh)
# turbo-q5 = เร็ว+เบา (แนะนำ) · large-v3 = แม่นสุดแต่ช้า
WHISPER_MODEL=models/ggml-large-v3-turbo-q5_0.bin
# default spoken language of meetings (th, en, ja, auto, ...)
WHISPER_LANG=th
# number of CPU threads
WHISPER_THREADS=8
# โมเดล VAD — ตัดช่วงเงียบก่อนถอดเสียง กันอาการหลอนคำซ้ำบนแทร็กที่ไม่มีคนพูด
# ไม่มีไฟล์นี้ก็ถอดได้ แต่แทร็กเงียบจะได้ข้อความขยะ
VAD_MODEL=models/ggml-silero-v5.1.2.bin

# เก็บภาพหน้าจอบอท (logs/bot_*.png) และโฟลเดอร์พักที่กำพร้า (recordings/bot/) ไว้กี่วัน
# ของพวกนี้เป็นข้อมูลของการประชุมจริง — ภาพเห็นชื่อผู้เข้าร่วม/แชท ส่วนโฟลเดอร์พักมีไฟล์เสียง
# ที่ย้ายไปปลายทางไม่สำเร็จ ซึ่งอาจไม่มีสำเนาที่อื่น worker จะลบให้วันละครั้ง
# 0 = เก็บตลอดไป (ต้องเลือกเอง ไม่ใช่ได้เพราะลืมตั้ง)
BOT_RETENTION_DAYS=30

# เปิด sandbox ของ Chromium ในคอนเทนเนอร์บอท (BACKLOG #21b)
# ปิดอยู่ = ส่ง --no-sandbox เหมือนเดิม: renderer ที่ถูกเจาะจะถึงทุกอย่างที่ mount เข้าไป
# รวม /prof ที่มี session ที่ล็อกอิน Google ของบอท
# เปิดแล้ว **ต้องทดสอบด้วยการส่งบอทเข้าห้องจริงหนึ่งครั้ง** — ถ้า host ไม่รองรับ
# Chromium จะไม่เปิดเลย และอาการที่เห็นคือ "บอทไม่เข้าห้อง" เฉย ๆ
# เลือกอย่างใดอย่างหนึ่ง (seccomp แคบกว่า จึงดีกว่าถ้ามีไฟล์โปรไฟล์อยู่แล้ว):
MAI_BOT_SANDBOX=0
# MAI_BOT_SECCOMP=/etc/docker/chrome-seccomp.json

# ---- Remote worker (ใช้ตอน deploy เว็บขึ้น cloud ที่ไม่มี GPU) ----
# ฝั่งเซิร์ฟเวอร์: REMOTE_WORKER=1 = ไม่ประมวลผลเอง รอ `mai worker` มารับงาน
# ปล่อยเป็น 0 = เว็บทำงานเองในเครื่องเหมือนเดิม
REMOTE_WORKER=0
# ต้องตั้งค่านี้ทั้งสองฝั่งให้ตรงกัน — ว่างไว้ = ปิด worker API ทั้งชุด
# สร้างด้วย: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_TOKEN=

# ---- โหมด cloud (ไม่ตั้ง = ทำงานในเครื่อง เก็บเป็นไฟล์ ไม่มีล็อกอิน) ----
# ต้องเปิดอย่างชัดเจน: `mai web --cloud` หรือ MEETING_AI_CLOUD=1
# แค่มี DATABASE_URL เฉยๆ จะไม่สลับโหมดให้ (กันเผลอทำเครื่องมือในเครื่องเปลี่ยนพฤติกรรม)
# MEETING_AI_CLOUD=1

# Postgres — Neon แนะนำให้ใช้ host ที่มี -pooler
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ที่เก็บไฟล์เสียง — Cloudflare R2 (หรืออะไรก็ได้ที่พูด S3)
# ไม่ตั้ง = เก็บลงดิสก์ (ใช้ได้เฉพาะตอนรันในเครื่อง — Vercel เขียนดิสก์ไม่ได้)
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=meeting-ai
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# โหมด cloud ใช้ S3_* ให้เองเป็นค่าเริ่มต้น ส่วนโหมดไฟล์ (รันในเครื่อง) จะ *ไม่* แตะ bucket ให้เอง
# ถึงจะตั้ง S3_* ไว้ครบ — กันเผลอออก presigned URL ของ bucket production ระหว่างเทส (BUG-045)
# ตั้งค่านี้เมื่อ *ตั้งใจ* ให้เครื่องตัวเองเขียน bucket จริง (ควรชี้ไป bucket ทดสอบของตัวเอง)
# MEETING_AI_REMOTE_BLOBS=1

# ---- Recording (ffmpeg: avfoundation on macOS, dshow on Windows) ----
FFMPEG_BIN=ffmpeg
# audio device index as printed by `mai devices` — a device name also works
# MIC_DEVICE    = your microphone
# SYSTEM_DEVICE = the loopback that captures meeting audio
#                 macOS: BlackHole · Windows: VB-CABLE / Stereo Mix
# leave SYSTEM_DEVICE empty if you have no loopback yet (then use: mai record ... --no-system)
MIC_DEVICE=0
SYSTEM_DEVICE=1
