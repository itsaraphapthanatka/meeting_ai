# ---- Summarization LLM (OpenAI-compatible endpoint) ----
LLM_BASE_URL=https://consoletoken.aunjai.org/api/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gemma-4-12b

# ---- Transcription (whisper.cpp) ----
# path to the whisper-cli binary (leave 'whisper-cli' if on PATH from brew)
WHISPER_BIN=whisper-cli
# path to the ggml model file (downloaded by setup.sh)
# turbo-q5 = เร็ว+เบา (แนะนำ) · large-v3 = แม่นสุดแต่ช้า
WHISPER_MODEL=models/ggml-large-v3-turbo-q5_0.bin
# default spoken language of meetings (th, en, ja, auto, ...)
WHISPER_LANG=th
# number of CPU threads
WHISPER_THREADS=8

# ---- Recording (ffmpeg + avfoundation) ----
FFMPEG_BIN=ffmpeg
# avfoundation audio device indexes (see: mai devices)
# MIC_DEVICE = your microphone, SYSTEM_DEVICE = BlackHole loopback
MIC_DEVICE=0
SYSTEM_DEVICE=1
