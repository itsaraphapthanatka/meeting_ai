# ค่าของ worker ที่ต่างกันทุกเครื่อง — คัดลอกไปไว้ที่ /etc/default/meeting-ai-worker
# (install-worker-service.sh คัดลอกให้เองถ้ายังไม่มี)
#
# ไฟล์นี้ถูกอ่านโดย systemd ไม่ใช่โดย shell: ห้ามใช้ `export`, ห้ามมีช่องว่างรอบ `=`
# และเครื่องหมายคำพูดจะกลายเป็นส่วนหนึ่งของค่า
#
# **ห้ามใส่ความลับที่นี่** — WORKER_TOKEN อ่านจาก .env ของโปรเจกต์ตามเดิม

# ที่อยู่เซิร์ฟเวอร์ที่ worker จะไปรับงาน
MAI_API=https://example.vercel.app

# รับงานบอทพร้อมกันได้กี่ห้อง (การถอดเสียงยังทำทีละงานเสมอ)
MAI_MAX_BOTS=3
